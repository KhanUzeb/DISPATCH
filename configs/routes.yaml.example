# Copy to routes.yaml and edit for your own workload. See classifier.py.

# Exemplar utterances per complexity tier. semantic-router embeds these and
# matches incoming prompts against them by cosine similarity -- expand each
# list with real prompts pulled from Langfuse traces once the router is
# running against live traffic (see README "Cache & route tuning").
#
# Tier names must match router.models.Tier values: cheap, mid, hard.

tiers:
  cheap:
    - "summarize this in one sentence"
    - "translate this sentence to spanish"
    - "extract the email addresses from this text"
    - "classify this message as spam or not spam"
    - "give me a yes or no answer"
    - "tl;dr this article for me"
    - "what is the capital of france"

  mid:
    - "explain how this function works"
    - "write a short blog post about this topic"
    - "generate five variations of this headline"
    - "answer this question using the provided context"
    - "convert this data into a table"
    - "write unit tests for this function"

  hard:
    - "design a distributed system for this use case"
    - "prove this mathematical statement step by step"
    - "refactor this codebase for better performance"
    - "debug this multi-threaded race condition"
    - "analyze the tradeoffs between these three architectures"
    - "compare and contrast these two algorithms in depth"
    - "plan a multi-step agentic workflow for this task"
