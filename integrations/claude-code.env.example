# Claude Code — Dispatch speaks Anthropic /v1/messages
#
# Start Dispatch with the claude-code profile:
#   $env:DISPATCH_PROFILE = "claude-code"
#   $env:DISPATCH_UPSTREAM_BASE_URL = "https://api.anthropic.com"
#   # Optional static key (else forward ANTHROPIC_AUTH_TOKEN / x-api-key):
#   # $env:DISPATCH_UPSTREAM_API_KEY = "sk-ant-..."
#   # $env:DISPATCH_MODEL_CHEAP = "claude-3-5-haiku-latest"
#   # $env:DISPATCH_MODEL_MID = "claude-sonnet-4-20250514"
#   # $env:DISPATCH_MODEL_HARD = "claude-opus-4-20250514"
#   uv run uvicorn src.api:app --host 0.0.0.0 --port 8000
#
# Point Claude Code at Dispatch (host root — Claude Code appends /v1/messages):

$env:ANTHROPIC_BASE_URL = "http://localhost:8000"
$env:ANTHROPIC_AUTH_TOKEN = "sk-ant-your-real-key"   # forwarded upstream
# Prefer AUTH_TOKEN for gateways; leave API_KEY empty to avoid header conflicts:
Remove-Item Env:ANTHROPIC_API_KEY -ErrorAction SilentlyContinue

claude
