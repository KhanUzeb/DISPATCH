# Codex — use Dispatch as a router over your OpenAI models
#
# Start Dispatch:
#   $env:DISPATCH_PROFILE = "codex"
#   $env:DISPATCH_UPSTREAM_BASE_URL = "https://api.openai.com/v1"
#   # Put your OpenAI key on the tool side (forwarded) OR here:
#   # $env:DISPATCH_UPSTREAM_API_KEY = "sk-..."
#   uv run uvicorn src.api:app --host 0.0.0.0 --port 8000
#
# Then point Codex at Dispatch (model name is ignored for selection — use "dispatch"):

$env:OPENAI_BASE_URL = "http://localhost:8000/v1"
$env:OPENAI_API_KEY  = "sk-your-real-openai-key"   # forwarded upstream by Dispatch

# Run Codex and select model: dispatch
