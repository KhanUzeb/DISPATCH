# Cursor — custom OpenAI-compatible provider
#
# Start Dispatch:
#   $env:DISPATCH_PROFILE = "default"   # or opencode / codex
#   $env:DISPATCH_UPSTREAM_BASE_URL = "https://openrouter.ai/api/v1"
#   uv run uvicorn src.api:app --host 0.0.0.0 --port 8000
#
# In Cursor Settings → Models → OpenAI-compatible / custom provider:
#   Base URL : http://localhost:8000/v1
#   API Key  : your real OpenRouter/OpenAI key (forwarded upstream)
#   Model    : dispatch
