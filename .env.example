GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional: require Bearer token for /route, /complete, /v1/*.
# Leave empty for open local demos. Set a value before exposing the port.
ROUTER_API_KEY=

# Soft per-IP rate limit (requests / rolling minute). 0 disables.
ROUTER_RATE_LIMIT_PER_MINUTE=60
# Cap on distinct client IPs tracked by the rate limiter (LRU eviction).
ROUTER_RATE_LIMIT_MAX_TRACKED_CLIENTS=10000
# Reject HTTP bodies larger than this (Content-Length) before JSON/Pydantic parse.
# Defense-in-depth alongside request_limits.max_prompt_chars in configs/router.yaml.
ROUTER_MAX_REQUEST_BYTES=2000000

# Optional additional providers (enable matching models in configs/models.yaml)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=

GOOGLE_API_KEY=

TOGETHER_API_KEY=
TOGETHER_BASE_URL=https://api.together.xyz/v1

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Local Ollama (no key required by default)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=

# Any other OpenAI-compatible endpoint
OPENAI_COMPATIBLE_BASE_URL=http://localhost:8001/v1
OPENAI_COMPATIBLE_API_KEY=

# Models are discovered live from Groq + OpenRouter (free) or the passthrough upstream.
# DISPATCH_DISCOVER=false   # force offline fallback_models only
# DISPATCH_DISCOVER_MODELS=true  # fetch tier map from upstream /v1/models

# Router profile / mode — demo = chat UI + MCP + execute-mode OpenAI compat
# DISPATCH_PROFILE=demo          # execute via discovered Groq/OpenRouter free models
# DISPATCH_PROFILE=default       # passthrough → OpenAI-compatible upstream
# DISPATCH_PROFILE=anthropic     # passthrough → Anthropic /v1/messages
# DISPATCH_MODE=passthrough
# DISPATCH_UPSTREAM_BASE_URL=https://openrouter.ai/api/v1
# DISPATCH_UPSTREAM_API_KEY=     # optional; else client Bearer/x-api-key is forwarded
# DISPATCH_MODEL_CHEAP=          # optional overrides after discovery
# DISPATCH_MODEL_MID=
# DISPATCH_MODEL_HARD=
# DISPATCH_PROTOCOL=openai       # or anthropic

# Use fake embeddings only for offline CI. For real routing quality (~80%+),
# leave this unset/false and install: uv pip install -e ".[embeddings]"
ROUTER_USE_FAKE_ENCODER=false

# Logging: text keeps ``[dispatch] …`` stderr lines for local terminals;
# json emits one structured object per line (deployments).
# ROUTER_LOG_FORMAT=text
# ROUTER_LOG_LEVEL=INFO

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
